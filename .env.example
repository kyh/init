# Supabase provides Postgres + the avatars storage bucket (auth is better-auth).
# Get these from your Supabase project settings, or let `pnpm bootstrap` fill
# them in from the local instance.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
POSTGRES_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

# The web app's port. `pnpm bootstrap` claims a free one so two checkouts (two
# agents) can run side by side; it also drives auth's baseUrl in dev, so change
# it here rather than passing --port.
PORT=3000

# Feature flags — the reversible unit of change. Comma-separated: `name` enables,
# `name=false` disables. The registry and its defaults live in
# packages/api/src/flags/flags.ts; unknown names are ignored with a warning.
# Set this per Vercel environment to ship a change dark and enable it on preview
# only. Read it server-side as `ctx.flags`, client-side via the `flag.list` query.
# FEATURE_FLAGS=""

# GitHub OAuth app credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Offline GitHub OAuth in dev: run `pnpm emulate`, then set this so the "Continue
# with GitHub" button routes through the local emulator (fixtures in
# emulate.config.yaml; the real provider above stays untouched). See AGENTS.md.
# NEXT_PUBLIC_GITHUB_EMULATOR_URL="http://localhost:4000"
# EXPO_PUBLIC_GITHUB_EMULATOR_URL="http://localhost:4000"  # same, for the mobile app

# Transactional email via Resend (https://resend.com). Leave unset in dev —
# emails are logged to the server console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM=""

# Stripe billing (https://dashboard.stripe.com/apikeys). Webhook endpoint:
# https://<your-domain>/api/auth/stripe/webhook — events: checkout.session.completed,
# customer.subscription.created/updated/deleted
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""

# Canonical site URL for metadata/sitemap/robots. Only needed off Vercel —
# on Vercel it derives from VERCEL_PROJECT_PRODUCTION_URL automatically.
# SITE_URL=""

# Mobile production builds only — the API server the Expo app talks to.
# Set it in eas.json build profile env; dev builds derive it from Metro.
# EXPO_PUBLIC_API_URL=""
