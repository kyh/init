{
  "name": "init",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:start": "pnpm -F db start",
    "db:stop": "pnpm -F db stop",
    "db:reset": "pnpm -F db reset && pnpm db:seed",
    "db:push": "pnpm -F db push",
    "db:push-remote": "pnpm -F db push:remote",
    "db:seed": "pnpm -F @repo/service seed",
    "dev": "turbo watch dev --continue",
    "dev:web": "turbo watch dev -F @repo/web...",
    "dev:mobile": "turbo watch dev -F @repo/mobile...",
    "dev:extension": "turbo watch dev -F @repo/extension...",
    "dev:desktop": "turbo watch dev -F @repo/desktop... -F @repo/web...",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check && turbo run format",
    "format:fix": "oxfmt --write && turbo run format:fix",
    "knip": "NODE_ENV=production POSTGRES_URL=postgresql://placeholder@127.0.0.1:5432/placeholder knip",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "turbo run test",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm knip && pnpm test",
    "smoke": "dotenv -e .env.local -e .env -- tsx scripts/smoke.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "emulate": "npx emulate@0.14.0 --service github"
  },
  "devDependencies": {
    "@interfere/landmines": "^0.1.1",
    "@orpc/client": "catalog:",
    "@repo/contract": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "^11.1.0",
    "knip": "^6.48.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsx": "catalog:",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "ultracite": "^8.3.1",
    "zod": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.23.0"
}
