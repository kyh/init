{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["WEBAPP_URL"],
      "outputs": [".output/app/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    // the bundle is signed with whatever the environment holds, so it is never replayed
    "package": {
      "cache": false,
      "env": ["WEBAPP_URL"],
      "outputs": [".output/bin/**"],
      "passThroughEnv": [
        "APPLE_API_ISSUER",
        "APPLE_API_KEY",
        "APPLE_API_KEY_ID",
        "APPLE_APP_SPECIFIC_PASSWORD",
        "APPLE_ID",
        "APPLE_TEAM_ID",
        "CSC_KEY_PASSWORD",
        "CSC_LINK",
        "GH_TOKEN"
      ]
    }
  }
}
