{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Init",
  "version": "../package.json",
  "identifier": "com.init.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://init.kyh.io",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Init",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "create": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
