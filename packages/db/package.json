{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./drizzle-client": "./src/drizzle-client.ts",
    "./drizzle-schema": "./src/drizzle-schema.ts",
    "./drizzle-schema-auth": "./src/drizzle-schema-auth.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "drizzle:kit": "pnpm with-env drizzle-kit",
    "start": "pnpm with-env docker compose up -d --wait",
    "stop": "pnpm with-env docker compose stop",
    "reset": "pnpm with-env docker compose down -v && pnpm start && pnpm push",
    "status": "pnpm with-env docker compose ps --all",
    "push": "pnpm with-env drizzle-kit push --force",
    "push:remote": "dotenv -e ../../.env.production.local -- drizzle-kit push",
    "studio": "pnpm with-env drizzle-kit studio",
    "with-env": "dotenv -e ../../.env --",
    "generate:auth-schema": "echo 'Disabled. @better-auth/cli is stuck at 1.4.21: it emits no account.issuer (required since better-auth 1.7) and strips hand-added indexes, RLS, and the rate_limit table. Running it silently breaks auth. Maintain src/drizzle-schema-auth.ts by hand until the CLI supports 1.7.' && exit 1"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
